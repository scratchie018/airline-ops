{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Airline Ops desktop client",
  "author": "Airline Ops",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "predist": "npm run build && rm -rf web-dist && cp -r ../web/dist web-dist",
    "dist": "npm run predist && electron-builder"
  },
  "devDependencies": {
    "app-builder-bin": "^5.0.0-alpha.10",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.airlineops.desktop",
    "productName": "Airline Ops",
    "electronVersion": "32.3.3",
    "npmRebuild": false,
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "web-dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
