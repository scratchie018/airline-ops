# Postgres connection string. For local dev, use the bundled docker-compose.yml.
# For production, point this at whatever you host it on (Supabase, Railway, Neon, RDS, ...).
DATABASE_URL="postgresql://airline:airline@localhost:5432/airline_ops"

# One shared Discord Application (https://discord.com/developers/applications) for
# every airline on the platform - OAuth2 tab.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must exactly match a Redirect URI registered on the application.
DISCORD_REDIRECT_URI="http://localhost:4000/auth/discord/callback"

# A Bot token (Bot tab on the same application) - the bot must be invited into
# each airline's own Discord server (with the "Server Members Intent" enabled) so
# the backend can look up a logging-in user's roles there to decide their app Role.
# Role mapping itself is per-airline, configured in-app, not here.
DISCORD_BOT_TOKEN=""

# Optional, and only ever read once: if this database still has data from before
# multi-airline support existed, its migration creates one default Airline with a
# placeholder Discord guild ID (a real one can't live in a committed migration
# file) - the server fixes that up from this var on its first boot after the
# migration runs, then never reads it again. Leave unset on a fresh install; the
# Owner sets each airline's guild ID through the UI when they create it instead.
DISCORD_GUILD_ID=""

# Long random string used to sign session JWTs - generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Where the web frontend is served from - used for post-login redirects and CORS.
WEB_ORIGIN="http://localhost:5173"

PORT=4000
