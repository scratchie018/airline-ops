# Postgres connection string. For local dev, use the bundled docker-compose.yml.
# For production, point this at whatever you host it on (Supabase, Railway, Neon, RDS, ...).
DATABASE_URL="postgresql://airline:airline@localhost:5432/airline_ops"

# Discord Application (https://discord.com/developers/applications) - OAuth2 tab.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must exactly match a Redirect URI registered on the application.
DISCORD_REDIRECT_URI="http://localhost:4000/auth/discord/callback"

# A Bot token (Bot tab on the same application) - the bot must be invited to your
# server with the "Server Members Intent" enabled, so the backend can look up a
# logging-in user's roles in your server to decide their app Role.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# The 5 Discord role IDs in your server that map to the 5 app roles. Right-click a
# role in Discord (Developer Mode on) -> Copy Role ID. A user who holds none of
# these defaults to PASSENGER, so only OWNER/MANAGER/FLIGHT_HOST/PILOT need mapping.
DISCORD_ROLE_ID_OWNER=""
DISCORD_ROLE_ID_MANAGER=""
DISCORD_ROLE_ID_FLIGHT_HOST=""
DISCORD_ROLE_ID_PILOT=""

# Long random string used to sign session JWTs - generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Where the web frontend is served from - used for post-login redirects and CORS.
WEB_ORIGIN="http://localhost:5173"
# Electron's OAuth loopback also needs to be allowed to redirect back.
DESKTOP_REDIRECT_ORIGIN="http://localhost:4100"

PORT=4000
