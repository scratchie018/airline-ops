generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  FLIGHT_HOST
  PILOT
  PASSENGER
}

enum FlightStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  EN_ROUTE
  LANDED
  CANCELLED
}

enum AircraftStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum CrewPosition {
  PILOT
  FLIGHT_HOST
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum DrinkOrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model User {
  id               String   @id @default(uuid())
  discordId        String   @unique
  discordUsername  String
  discordAvatarUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships      Membership[]
  createdFlights   Flight[]         @relation("FlightCreatedBy")
  crewAssignments  CrewAssignment[]
  bookings         Booking[]
  drinkOrders      DrinkOrder[]
  auditLogEntries  AuditLog[]
  ownedAirlines    Airline[]        @relation("AirlineCreatedBy")
}

/// One virtual airline "workspace" - the multi-tenancy boundary. Everything else
/// airline-specific (memberships/roles, fleet, flights, role mappings, audit log)
/// hangs off this via airlineId. Identified by the Discord server its staff/roles
/// live in; the shared Discord app's bot must be a member of that guild.
model Airline {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  discordGuildId    String   @unique
  /// Posts flight announcements (scheduled/status changes/cancellations) to this
  /// channel automatically - a real Discord webhook URL, validated server-side
  /// against Discord's own URL shape before it's ever stored or posted to, since
  /// this field drives a server-side outbound request (see discordWebhook.ts).
  discordWebhookUrl String?
  createdById       String
  createdBy         User     @relation("AirlineCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships  Membership[]
  roleMappings RoleMapping[]
  auditLog     AuditLog[]
  aircraft     Aircraft[]
  flights      Flight[]
}

/// A user's role within one specific airline - the same Discord account can have
/// a Membership (and a different role) in several airlines at once, which is why
/// Role moved here from User. Resolved fresh from that airline's Discord server
/// roles on every login (see services/discordAuth.ts) UNLESS roleLocked - set
/// automatically on the Owner membership created alongside a new Airline (so a
/// brand-new airline always has someone able to configure it, even before any
/// RoleMapping exists to reconfirm their Discord role as Owner), and settable by
/// an Owner on anyone via the Admin > Users panel for a genuinely permanent
/// override that Discord sync won't silently revert.
model Membership {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  airlineId  String
  airline    Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  role       Role     @default(PASSENGER)
  roleLocked Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, airlineId])
  @@index([airlineId, role])
}

/// Maps one Discord role ID (from this airline's server) to one app Role. Lets an
/// Owner configure role sync entirely through the UI - no more editing server env
/// vars and restarting just to add a role or fix a typo'd ID. Scoped per airline
/// since every airline has its own Discord server with its own role IDs.
model RoleMapping {
  id            String   @id @default(uuid())
  airlineId     String
  airline       Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  discordRoleId String
  appRole       Role
  label         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([airlineId, discordRoleId])
}

/// A lightweight trail of who did what to what - not exhaustive, just the actions
/// that matter for accountability in a multi-Owner/Manager org (role changes,
/// flight cancellations, crew changes). Append-only, never edited or deleted via
/// the API. Scoped per airline like everything else operational.
model AuditLog {
  id         String   @id @default(uuid())
  airlineId  String
  airline    Airline  @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([airlineId, createdAt])
  @@index([actorId])
}

model Aircraft {
  id           String         @id @default(uuid())
  airlineId    String
  airline      Airline        @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  tailNumber   String
  model        String
  seatCapacity Int
  status       AircraftStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  flights Flight[]

  @@unique([airlineId, tailNumber])
}

model Flight {
  id            String       @id @default(uuid())
  airlineId     String
  airline       Airline      @relation(fields: [airlineId], references: [id], onDelete: Cascade)
  flightNumber  String
  aircraftId    String
  aircraft      Aircraft     @relation(fields: [aircraftId], references: [id])
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  status        FlightStatus @default(SCHEDULED)
  createdById   String
  createdBy     User         @relation("FlightCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  crew        CrewAssignment[]
  bookings    Booking[]
  drinkOrders DrinkOrder[]

  @@unique([airlineId, flightNumber])
  @@index([airlineId, status])
  @@index([departureTime])
}

model CrewAssignment {
  id        String       @id @default(uuid())
  flightId  String
  flight    Flight       @relation(fields: [flightId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  position  CrewPosition
  createdAt DateTime     @default(now())

  @@unique([flightId, userId, position])
  @@index([flightId])
  @@index([userId])
}

model Booking {
  id         String        @id @default(uuid())
  flightId   String
  flight     Flight        @relation(fields: [flightId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  seatNumber String?
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())

  @@unique([flightId, userId])
  @@index([flightId])
  @@index([userId])
}

/// A passenger's (or crew member's) drink order on a flight - the one thing a
/// Passenger can actively do beyond booking a seat and watching status change.
/// No airlineId of its own; scoped through flightId the same way CrewAssignment
/// and Booking already are.
model DrinkOrder {
  id        String           @id @default(uuid())
  flightId  String
  flight    Flight           @relation(fields: [flightId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  item      String
  status    DrinkOrderStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@index([flightId, status])
  @@index([userId])
}

/// The desktop app's OAuth handoff, keyed by the random id it generates before
/// opening the system browser (see desktop/src/main.ts and
/// services/desktopAuthSessions.ts). Has to be a real table, not an in-memory
/// Map on the API process - a free-tier Render service can restart (a deploy,
/// or just going back to sleep after 15 idle minutes) at any point between the
/// browser showing "Signed in" and the desktop app's next poll, which would
/// silently wipe an in-memory store and strand that login forever.
model DesktopAuthSession {
  id        String   @id
  token     String
  expiresAt DateTime
}
